{
	"name": "@comic/api",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/src/index.d.ts",
			"default": "./src/index.ts"
		},
		"./*": {
			"types": "./dist/src/*.d.ts",
			"default": "./src/*.ts"
		}
	},
	"scripts": {
		"build": "tsc -b",
		"check-types": "tsc -b",
		"dev": "tsc -b --watch"
	},
	"dependencies": {
		"@comic/admin": "workspace:*",
		"@comic/auth": "workspace:*",
		"@comic/db": "workspace:*",
		"@comic/publishing": "workspace:*",
		"@comic/reading": "workspace:*",
		"@comic/social": "workspace:*",
		"@comic/storage": "workspace:*",
		"@orpc/client": "catalog:",
		"@orpc/openapi": "catalog:",
		"@orpc/server": "catalog:",
		"@orpc/zod": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@comic/config": "workspace:*",
		"typescript": "catalog:"
	}
}
